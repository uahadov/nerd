# Builds and installers
*.apk
*.aab
*.ipa
*.appimage
*.AppImage
# Secrets and signing material; never add a real secret with git add -f
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
credentials.json
service-account*.json
secrets/
# Host-specific AI state; shared rules live only in AGENTS.md
.codex/
.gemini/
.antigravity/
.codex-gravity/
# Operating system files
.DS_Store
Thumbs.db
*~

# Unity crash recovery stays local; never discard recovered scenes automatically.
/unity/Assets/_Recovery/
/unity/Assets/_Recovery.meta

# Android native/Gradle caches generated by Unity 6 builds.
.utmp/
.gradle/
.cxx/
